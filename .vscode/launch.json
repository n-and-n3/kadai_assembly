{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C: 開いているファイルをGDBでデバッグ (WSL)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "GDBの構造体などを読みやすく表示する",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C/C++: gcc アクティブなファイルのビルド"
    }
  ]
}
